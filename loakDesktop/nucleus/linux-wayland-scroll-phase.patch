+/// PATCH(nucleus): the [`ScrollPhase`] of a touchpad scroll. GDK ends a finger
+/// scroll with a zero-delta stop event, which only Wayland sends (X11 never
+/// says when a scroll is over), so there touchpad scrolls stay phase-less, like
+/// wheels. No momentum phases: GDK leaves kinetic scrolling to the toolkit.
+/// `None` drops the event: a stop outside a touchpad scroll.
+fn touchpad_scroll_phase(
+  event: &gdk::EventScroll,
+  is_wayland: bool,
+  scrolling: &std::cell::Cell<bool>,
+) -> Option<crate::event::ScrollPhase> {
+  use crate::event::ScrollPhase;
+  if event.is_stop() {
+    return scrolling.replace(false).then_some(ScrollPhase::Ended);
+  }
+  let touchpad = is_wayland
+    && event.direction() == ScrollDirection::Smooth
+    && event
+      .source_device()
+      .is_some_and(|device| device.input_source() == gdk::InputSource::Touchpad);
+  Some(if !touchpad {
+    ScrollPhase::None
+  } else if scrolling.replace(true) {
+    ScrollPhase::Changed
+  } else {
+    ScrollPhase::Began
+  })
+}
